# Copy to .env. Credentials are read only by the backend.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Enable only once your Photon line and credentials are ready.
PHOTON_ENABLED=false
GEMINI_API_KEY=
# Optional: choose a vision model available to your Gemini account.
GEMINI_MODEL=gemini-3.5-flash
# Tiger Data (Postgres) connection string from the Tiger Cloud console.
# Leave empty to store live state in data/real-state.json instead.
DATABASE_URL=
# Optional CA certificate file for hostname-verified TLS (kept locally).
DATABASE_SSL_CA_FILE=
PORT=3001

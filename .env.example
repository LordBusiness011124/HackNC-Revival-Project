# Copy to .env. Credentials are read only by the backend.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Enable only once your Photon line and credentials are ready.
PHOTON_ENABLED=false
GEMINI_API_KEY=
# Optional: choose a text model available to your Gemini account.
GEMINI_MODEL=gemini-3.8-flash
# Tiger Data (Postgres) connection string from the Tiger Cloud console.
# Leave empty to store demo state in data/state.json instead.
DATABASE_URL=
PORT=3001
